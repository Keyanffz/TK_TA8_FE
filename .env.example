# Base URL API backend, termasuk prefix /api/v1. Dipakai server Next.js (route handler dan
# Server Component). Harus alamat yang juga bisa dibuka browser, karena signed URL file private
# dibentuk dari host request yang diterima backend.
BE_API_URL=http://localhost:8000/api/v1

# Path atau URL api.json hasil Scramble, dibaca `npm run gen:api`.
API_SPEC_PATH=../TK_TA8_BE/storage/api-docs/api.json

# Client ID OAuth Google Identity Services, sama dengan GOOGLE_CLIENT_ID di backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
